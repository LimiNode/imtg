PROJECT_NAME           = imtg
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = @IMTG_DOXYGEN_OUTPUT_DIRECTORY@
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src/imtg/sessions \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/imtg/storage/storage.hpp
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = @IMTG_DOXYGEN_OUTPUT_DIRECTORY@/warnings.log
