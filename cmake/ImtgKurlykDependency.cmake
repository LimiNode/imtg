# Parent-owned targets win before examining any imtg source provider paths.
if(TARGET kurlyk::kurlyk)
    set(imtg_kurlyk_target kurlyk::kurlyk)
elseif(TARGET kurlyk)
    set(imtg_kurlyk_target kurlyk)
else()
    if(CMAKE_VERSION VERSION_LESS 3.21)
        message(FATAL_ERROR "The pinned kurlyk provider requires CMake 3.21 or newer")
    endif()
    set(IMTG_KURLYK_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/external/kurlyk"
        CACHE PATH "Pinned kurlyk provider used when no target is supplied")
    if(NOT EXISTS "${IMTG_KURLYK_SOURCE_DIR}/CMakeLists.txt")
        message(FATAL_ERROR "Provide kurlyk::kurlyk or initialize external/kurlyk")
    endif()

    if(NOT TARGET CURL::libcurl)
        find_package(CURL QUIET)
        if(NOT TARGET CURL::libcurl AND MINGW)
            set(imtg_curl_root "${CMAKE_CURRENT_SOURCE_DIR}/external/curl-win64-mingw")
            if(NOT EXISTS "${imtg_curl_root}/lib/libcurl.dll.a")
                message(FATAL_ERROR "Provide CURL::libcurl or initialize external/curl-win64-mingw")
            endif()
            set(CURL_INCLUDE_DIR "${imtg_curl_root}/include")
            set(CURL_LIBRARY_RELEASE "${imtg_curl_root}/lib/libcurl.dll.a")
            set(CURL_LIBRARY "${CURL_LIBRARY_RELEASE}")
            find_package(CURL REQUIRED)
            list(APPEND IMTG_KURLYK_RUNTIME_DLLS "${imtg_curl_root}/bin/libcurl-x64.dll")
        elseif(NOT TARGET CURL::libcurl)
            message(FATAL_ERROR "Provide system CURL::libcurl before enabling IMTG_BUILD_TELEGRAM_KURLYK")
        endif()
    endif()
    if(NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto)
        find_package(OpenSSL QUIET)
        if((NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto) AND MINGW)
            set(imtg_openssl_root "${CMAKE_CURRENT_SOURCE_DIR}/external/openssl-win64")
            if(NOT EXISTS "${imtg_openssl_root}/lib/VC/x64/MD/libssl.lib")
                message(FATAL_ERROR "Provide OpenSSL targets or initialize external/openssl-win64")
            endif()
            set(OPENSSL_INCLUDE_DIR "${imtg_openssl_root}/include")
            set(OPENSSL_SSL_LIBRARY "${imtg_openssl_root}/lib/VC/x64/MD/libssl.lib")
            set(OPENSSL_CRYPTO_LIBRARY "${imtg_openssl_root}/lib/VC/x64/MD/libcrypto.lib")
            # FindOpenSSL's MinGW branch derives its public paths from these names.
            set(SSL_EAY "${OPENSSL_SSL_LIBRARY}")
            set(LIB_EAY "${OPENSSL_CRYPTO_LIBRARY}")
            find_package(OpenSSL REQUIRED)
            list(APPEND IMTG_KURLYK_RUNTIME_DLLS
                "${imtg_openssl_root}/bin/libssl-3-x64.dll"
                "${imtg_openssl_root}/bin/libcrypto-3-x64.dll")
        elseif(NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto)
            message(FATAL_ERROR "Provide system OpenSSL targets before enabling IMTG_BUILD_TELEGRAM_KURLYK")
        endif()
    endif()
    set(KURLYK_USE_STANDALONE_ASIO ON CACHE BOOL "Use standalone Asio for kurlyk")
    if(KURLYK_USE_STANDALONE_ASIO AND NOT TARGET asio::asio)
        set(imtg_asio_include "${CMAKE_CURRENT_SOURCE_DIR}/external/asio/include")
        if(NOT EXISTS "${imtg_asio_include}/asio.hpp")
            message(FATAL_ERROR "Provide asio::asio or initialize external/asio")
        endif()
        add_library(asio::asio INTERFACE IMPORTED GLOBAL)
        set_target_properties(asio::asio PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${imtg_asio_include}"
            INTERFACE_COMPILE_DEFINITIONS ASIO_STANDALONE)
        install(DIRECTORY "${imtg_asio_include}/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
        install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/external/asio/LICENSE_1_0.txt"
            DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/imtg/asio")
    endif()
    if(NOT TARGET simple_ws_server)
        if(NOT TARGET SimpleWebSocketServer::simple-websocket-server)
            set(imtg_sws_source "${CMAKE_CURRENT_SOURCE_DIR}/external/Simple-WebSocket-Server")
            if(NOT EXISTS "${imtg_sws_source}/CMakeLists.txt")
                message(FATAL_ERROR "Provide simple_ws_server or initialize external/Simple-WebSocket-Server")
            endif()
            set(USE_STANDALONE_ASIO ${KURLYK_USE_STANDALONE_ASIO} CACHE BOOL "Asio backend shared with SWS")
            if((USE_STANDALONE_ASIO AND NOT KURLYK_USE_STANDALONE_ASIO)
                    OR (NOT USE_STANDALONE_ASIO AND KURLYK_USE_STANDALONE_ASIO))
                message(FATAL_ERROR "Kurlyk and Simple-WebSocket-Server must use the same Asio backend")
            endif()
            function(imtg_add_sws_provider)
                set(BUILD_TESTING OFF)
                set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
                add_subdirectory("${imtg_sws_source}" "${CMAKE_CURRENT_BINARY_DIR}/_deps/simple-ws")
            endfunction()
            imtg_add_sws_provider()
            # This pinned SWS only installs when top-level. Supply its standard
            # installed header layout without initializing its nested gitlinks.
            foreach(header asio_compatibility.hpp client_ws.hpp server_ws.hpp client_wss.hpp
                    server_wss.hpp crypto.hpp utility.hpp status_code.hpp mutex.hpp)
                install(FILES "${imtg_sws_source}/${header}"
                    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/simple-websocket-server")
            endforeach()
            install(FILES "${imtg_sws_source}/LICENSE"
                DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/imtg/Simple-WebSocket-Server")
        endif()
        get_target_property(imtg_sws_original SimpleWebSocketServer::simple-websocket-server ALIASED_TARGET)
        if(imtg_sws_original)
            add_library(simple_ws_server ALIAS ${imtg_sws_original})
        else()
            add_library(simple_ws_server ALIAS SimpleWebSocketServer::simple-websocket-server)
        endif()
    endif()
    # The source provider is deliberately offline, even if a caller's shared
    # cache permits downloads for another project. Existing targets are untouched.
    set(KURLYK_ALLOW_DOWNLOADS OFF)
    set(KURLYK_BUILD_EXAMPLES OFF)
    add_subdirectory("${IMTG_KURLYK_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/_deps/kurlyk")
    set(imtg_kurlyk_target kurlyk::kurlyk)
endif()
if(NOT TARGET ${imtg_kurlyk_target})
    message(FATAL_ERROR "Required kurlyk target was not resolved")
endif()
# Keep a parent's source target out of imtg's installed export set.
add_library(imtg_kurlyk_private_dependency INTERFACE IMPORTED GLOBAL)
set_property(TARGET imtg_kurlyk_private_dependency PROPERTY
    INTERFACE_LINK_LIBRARIES ${imtg_kurlyk_target})
