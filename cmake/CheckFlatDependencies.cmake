cmake_minimum_required(VERSION 3.16)
find_package(Git REQUIRED)
if(NOT DEFINED IMTG_SOURCE_DIR)
    message(FATAL_ERROR "Set IMTG_SOURCE_DIR to the imtg checkout")
endif()
get_filename_component(IMTG_SOURCE_DIR "${IMTG_SOURCE_DIR}" ABSOLUTE)

execute_process(COMMAND "${GIT_EXECUTABLE}" submodule status
    WORKING_DIRECTORY "${IMTG_SOURCE_DIR}"
    OUTPUT_VARIABLE status RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect direct submodules")
endif()
string(REPLACE "\n" ";" entries "${status}")
set(paths)
foreach(entry IN LISTS entries)
    if(entry STREQUAL "")
        continue()
    endif()
    if(NOT entry MATCHES "^ [0-9a-f]+ (external/[^/ ]+)( |$)")
        message(FATAL_ERROR "Dependency must be a pinned, initialized direct sibling: ${entry}")
    endif()
    list(APPEND paths "${CMAKE_MATCH_1}")
endforeach()
list(SORT paths)
if(NOT "${paths}" STREQUAL "external/libmdbx;external/mdbx-containers")
    message(FATAL_ERROR "Update the dependency audit for the new inventory: ${paths}")
endif()

foreach(path IN LISTS paths)
    execute_process(COMMAND "${GIT_EXECUTABLE}" submodule status --recursive
        WORKING_DIRECTORY "${IMTG_SOURCE_DIR}/${path}"
        OUTPUT_VARIABLE nested RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect nested dependencies of ${path}")
    endif()
    string(REPLACE "\n" ";" entries "${nested}")
    foreach(entry IN LISTS entries)
        if(NOT entry STREQUAL "" AND NOT entry MATCHES "^-[0-9a-f]+ ")
            message(FATAL_ERROR "Nested dependency must remain uninitialized: ${path}: ${entry}")
        endif()
    endforeach()
endforeach()
message(STATUS "Direct dependencies match gitlinks; nested dependencies remain uninitialized")
