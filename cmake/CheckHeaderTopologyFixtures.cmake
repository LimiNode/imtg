cmake_minimum_required(VERSION 3.18)
if(NOT DEFINED IMTG_SOURCE_DIR OR NOT DEFINED IMTG_BINARY_DIR)
    message(FATAL_ERROR "Set IMTG_SOURCE_DIR and IMTG_BINARY_DIR")
endif()
get_filename_component(IMTG_SOURCE_DIR "${IMTG_SOURCE_DIR}" ABSOLUTE)
get_filename_component(IMTG_BINARY_DIR "${IMTG_BINARY_DIR}" ABSOLUTE)
set(checker "${IMTG_SOURCE_DIR}/cmake/CheckHeaderTopology.cmake")
function(run_fixture name expected)
    set(root "${IMTG_BINARY_DIR}/topology-fixtures/${name}")
    file(MAKE_DIRECTORY "${root}/cmake" "${root}/src/imtg/core"
        "${root}/src/imtg/storage" "${root}/src/imtg/runtime")
    file(WRITE "${root}/cmake/ImtgPublicHeaders.cmake" [=[
set(IMTG_CORE_PUBLIC_HEADERS imtg/core.hpp imtg/core/A.hpp imtg/core/B.hpp
    imtg/storage.hpp imtg/storage/storage.hpp imtg/runtime.hpp imtg/runtime/Route.hpp)
set(IMTG_PRIVATE_HEADERS imtg/core/Private.hpp)
set(IMTG_SOURCE_ONLY_HEADERS imtg/storage/mdbx_storage.hpp)
]=])
    file(WRITE "${root}/src/imtg/core.hpp" "#include \"core/A.hpp\"\n")
    file(WRITE "${root}/src/imtg/core/A.hpp" "// public narrow data contract\n")
    file(WRITE "${root}/src/imtg/core/B.hpp" "// public component\n")
    file(WRITE "${root}/src/imtg/core/Private.hpp" "// explicitly private\n")
    file(WRITE "${root}/src/imtg/runtime.hpp" "#include <imtg/core/A.hpp>\n#include \"runtime/Route.hpp\"\n")
    file(WRITE "${root}/src/imtg/runtime/Route.hpp" "// public component\n")
    file(WRITE "${root}/src/imtg/storage.hpp" "#include <imtg/core/A.hpp>\n#include \"storage/storage.hpp\"\n")
    file(WRITE "${root}/src/imtg/storage/storage.hpp" "#include <imtg/core/A.hpp>\n")
    file(WRITE "${root}/src/imtg/storage/mdbx_storage.hpp" "#include \"storage.hpp\"\n")
    file(WRITE "${root}/src/imtg/storage/mdbx_storage.cpp" "#include \"mdbx_storage.hpp\"\n")
    if(name STREQUAL "spaced_positive")
        file(WRITE "${root}/src/imtg/storage/storage.hpp" "  # include<imtg/core/A.hpp>\n")
    elseif(name STREQUAL "private_positive")
        file(WRITE "${root}/src/imtg/core/Private.hpp" "#include \"B.hpp\"\n")
    elseif(name STREQUAL "spaced_upward")
        file(WRITE "${root}/src/imtg/core/A.hpp" " \t# include <imtg/runtime.hpp>\n")
    elseif(name STREQUAL "quoted_upward")
        file(WRITE "${root}/src/imtg/core.hpp" "#include \"runtime/Route.hpp\"\n")
    elseif(name STREQUAL "quoted_cross_domain")
        file(WRITE "${root}/src/imtg/storage.hpp" "#include \"core/A.hpp\"\n")
    elseif(name STREQUAL "parent_path")
        file(WRITE "${root}/src/imtg/core/A.hpp" "# include \"../core/B.hpp\"\n")
    elseif(name STREQUAL "own_umbrella")
        file(WRITE "${root}/src/imtg/core/A.hpp" " #include \"imtg/core.hpp\"\n")
    elseif(name STREQUAL "local_cycle")
        file(WRITE "${root}/src/imtg/core/A.hpp" "#include \"B.hpp\"\n")
        file(WRITE "${root}/src/imtg/core/B.hpp" "#include \"A.hpp\"\n")
    elseif(name STREQUAL "source_only_upward")
        file(APPEND "${root}/src/imtg/storage/mdbx_storage.hpp" "# include <imtg/runtime.hpp>\n")
    elseif(name STREQUAL "private_cross_domain")
        file(WRITE "${root}/src/imtg/storage/storage.hpp" "#include <imtg/core/Private.hpp>\n")
    elseif(name STREQUAL "uninstalled_dependency")
        file(WRITE "${root}/src/imtg/core/A.hpp" "#include \"Private.hpp\"\n")
    elseif(name STREQUAL "rooted_local")
        file(WRITE "${root}/src/imtg/core/A.hpp" "#include <imtg/core/B.hpp>\n")
    elseif(name STREQUAL "missing_local")
        file(WRITE "${root}/src/imtg/core/A.hpp" "#include \"Missing.hpp\"\n")
    elseif(name STREQUAL "unclassified")
        file(WRITE "${root}/src/imtg/core/Undeclared.hpp" "// not classified\n")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DIMTG_SOURCE_DIR=${root}" -P "${checker}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "PASS")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Positive fixture ${name} failed: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Negative fixture ${name} did not diagnose ${expected}: ${output}${error}")
    endif()
    message(STATUS "Topology fixture ${name}: expected result observed")
endfunction()
run_fixture(narrow_source_only_positive PASS)
run_fixture(spaced_positive PASS)
run_fixture(private_positive PASS)
run_fixture(spaced_upward "Forbidden domain dependency")
run_fixture(quoted_upward "Forbidden domain dependency")
run_fixture(quoted_cross_domain "Cross-domain entry must use angle brackets")
run_fixture(parent_path "Parent-relative include")
run_fixture(own_umbrella "Leaf includes its owning umbrella")
run_fixture(local_cycle "Project include cycle")
run_fixture(source_only_upward "Forbidden domain dependency")
run_fixture(private_cross_domain "Cross-domain entry is not public")
run_fixture(uninstalled_dependency "Installed header depends on an uninstalled header")
run_fixture(rooted_local "Use local intra-domain includes")
run_fixture(missing_local "Missing project header")
run_fixture(unclassified "Classify the header")
