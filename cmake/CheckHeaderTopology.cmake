cmake_minimum_required(VERSION 3.18)
if(NOT DEFINED IMTG_SOURCE_DIR)
    message(FATAL_ERROR "Set IMTG_SOURCE_DIR to the imtg source tree")
endif()
get_filename_component(IMTG_SOURCE_DIR "${IMTG_SOURCE_DIR}" ABSOLUTE)
set(source_root "${IMTG_SOURCE_DIR}/src/imtg")
include("${IMTG_SOURCE_DIR}/cmake/ImtgPublicHeaders.cmake")
set(public_headers ${IMTG_CORE_PUBLIC_HEADERS} ${IMTG_COMMERCE_PUBLIC_HEADERS}
    ${IMTG_TELEGRAM_PUBLIC_HEADERS} ${IMTG_TELEGRAM_TRANSPORT_PUBLIC_HEADERS}
    ${IMTG_TELEGRAM_KURLYK_PUBLIC_HEADERS})
set(classified_headers ${public_headers} ${IMTG_PRIVATE_HEADERS} ${IMTG_SOURCE_ONLY_HEADERS})
set(domains core actions storage sessions reconciliation ui runtime commerce telegram telegram_transport)
set(core_dependencies)
set(actions_dependencies core)
set(storage_dependencies core)
set(sessions_dependencies core storage)
set(reconciliation_dependencies core storage sessions)
set(ui_dependencies core actions)
set(runtime_dependencies core actions ui)
set(commerce_dependencies core storage)
set(telegram_dependencies core runtime)
set(telegram_transport_dependencies telegram)
foreach(domain IN LISTS domains)
    list(FIND domains "${domain}" domain_index)
    foreach(dependency IN LISTS ${domain}_dependencies)
        list(FIND domains "${dependency}" dependency_index)
        if(dependency_index LESS 0 OR NOT dependency_index LESS domain_index)
            message(FATAL_ERROR "Domain dependency graph is not acyclic: ${domain} -> ${dependency}")
        endif()
    endforeach()
endforeach()
set(compatibility_headers
    core/core.hpp actions/actions.hpp actions/registry.hpp ui/ui.hpp runtime/runtime.hpp)
file(GLOB_RECURSE files RELATIVE "${source_root}"
    "${source_root}/*.hpp" "${source_root}/*.cpp")
foreach(file IN LISTS files)
    string(REGEX MATCH "^[^/.]+" domain "${file}")
    if(NOT domain IN_LIST domains)
        message(FATAL_ERROR "Unclassified domain: ${file}")
    endif()
    if(file MATCHES "[.]hpp$" AND NOT "imtg/${file}" IN_LIST classified_headers)
        message(FATAL_ERROR "Classify the header as public, private or source-only: ${file}")
    endif()
    string(MD5 key "${file}")
    set(edges_${key})
    file(STRINGS "${source_root}/${file}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
    set(first TRUE)
    foreach(line IN LISTS includes)
        if(NOT line MATCHES "^[ \t]*#[ \t]*include[ \t]*([<\"])([^>\"]+)[>\"]")
            message(FATAL_ERROR "Unrecognized include: ${file}: ${line}")
        endif()
        set(delimiter "${CMAKE_MATCH_1}")
        set(entry "${CMAKE_MATCH_2}")
        string(REPLACE "\\" "/" entry "${entry}")
        if(entry MATCHES "(^|/)[.][.](/|$)")
            message(FATAL_ERROR "Parent-relative include: ${file}: ${line}")
        endif()
        set(is_first ${first})
        if(first AND file MATCHES "[.]cpp$")
            if(file STREQUAL "storage/mdbx_storage.cpp")
                set(expected "mdbx_storage.hpp")
                set(expected_delimiter "\"")
            elseif(file STREQUAL "telegram_transport/KurlykHttpTransport.cpp")
                set(expected "imtg/telegram_transport/KurlykHttpTransport.hpp")
                set(expected_delimiter "<")
            else()
                set(expected "imtg/${domain}.hpp")
                set(expected_delimiter "<")
            endif()
            if(NOT entry STREQUAL expected OR NOT delimiter STREQUAL expected_delimiter)
                message(FATAL_ERROR "Implementation must start with its declared entry: ${file}")
            endif()
        endif()
        set(first FALSE)
        if(entry MATCHES "^imtg/(.+)$")
            set(target "${CMAKE_MATCH_1}")
        elseif(delimiter STREQUAL "\"")
            get_filename_component(directory "${file}" DIRECTORY)
            get_filename_component(absolute "${source_root}/${directory}/${entry}" ABSOLUTE)
            file(RELATIVE_PATH target "${source_root}" "${absolute}")
            if(target MATCHES "^[.][.]/" OR IS_ABSOLUTE "${target}")
                message(FATAL_ERROR "Local include escapes the source boundary: ${file}: ${line}")
            endif()
        else()
            continue() # External or standard-library header, not a project edge.
        endif()
        if(NOT EXISTS "${source_root}/${target}")
            message(FATAL_ERROR "Missing project header: ${file}: ${line}")
        endif()
        string(REGEX MATCH "^[^/.]+" dependency "${target}")
        if(dependency STREQUAL domain)
            if(target STREQUAL "${domain}.hpp" AND file MATCHES "[.]hpp$"
                AND NOT file IN_LIST compatibility_headers)
                message(FATAL_ERROR "Leaf includes its owning umbrella: ${file}: ${line}")
            endif()
            if(entry MATCHES "^imtg/" AND NOT file IN_LIST compatibility_headers)
                if(NOT (is_first AND file MATCHES "[.]cpp$" AND
                    (target STREQUAL "${domain}.hpp" OR
                     file STREQUAL "telegram_transport/KurlykHttpTransport.cpp")))
                    message(FATAL_ERROR "Use local intra-domain includes: ${file}: ${line}")
                endif()
            endif()
        else()
            if(NOT dependency IN_LIST ${domain}_dependencies)
                message(FATAL_ERROR "Forbidden domain dependency: ${file}: ${line}")
            endif()
            if(NOT delimiter STREQUAL "<" OR NOT entry MATCHES "^imtg/")
                message(FATAL_ERROR "Cross-domain entry must use angle brackets: ${file}: ${line}")
            endif()
            if(NOT "imtg/${target}" IN_LIST public_headers)
                message(FATAL_ERROR "Cross-domain entry is not public: ${file}: ${line}")
            endif()
        endif()
        if("imtg/${file}" IN_LIST public_headers AND NOT "imtg/${target}" IN_LIST public_headers)
            message(FATAL_ERROR "Installed header depends on an uninstalled header: ${file}: ${line}")
        endif()
        if(file STREQUAL "telegram_transport.hpp" AND target MATCHES "KurlykHttpTransport[.]hpp$")
            message(FATAL_ERROR "Generic umbrella includes the optional kurlyk adapter")
        endif()
        list(APPEND edges_${key} "${target}")
    endforeach()
    if(first AND file MATCHES "[.]cpp$")
        message(FATAL_ERROR "Implementation has no declared entry: ${file}")
    endif()
endforeach()

# Removing sinks catches local cycles that the domain ordering cannot detect.
set(remaining ${files})
while(remaining)
    set(next)
    foreach(file IN LISTS remaining)
        string(MD5 key "${file}")
        set(blocked FALSE)
        foreach(target IN LISTS edges_${key})
            if(target IN_LIST remaining)
                set(blocked TRUE)
            endif()
        endforeach()
        if(blocked)
            list(APPEND next "${file}")
        endif()
    endforeach()
    if("${remaining}" STREQUAL "${next}")
        message(FATAL_ERROR "Project include cycle: ${remaining}")
    endif()
    set(remaining ${next})
endwhile()
foreach(header IN LISTS classified_headers)
    if(NOT EXISTS "${IMTG_SOURCE_DIR}/src/${header}")
        message(FATAL_ERROR "Manifest entry does not exist: ${header}")
    endif()
endforeach()
message(STATUS "Public/private/source-only classifications and hybrid include DAG verified")
