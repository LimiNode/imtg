cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED IMTG_SOURCE_DIR)
    message(FATAL_ERROR "Set IMTG_SOURCE_DIR to the imtg source tree")
endif()
get_filename_component(IMTG_SOURCE_DIR "${IMTG_SOURCE_DIR}" ABSOLUTE)
include("${IMTG_SOURCE_DIR}/cmake/ImtgPublicHeaders.cmake")
set(public_headers ${IMTG_CORE_PUBLIC_HEADERS} ${IMTG_COMMERCE_PUBLIC_HEADERS})
set(domains core actions storage sessions reconciliation ui runtime commerce)
set(core_dependencies)
set(actions_dependencies core)
set(storage_dependencies core)
set(sessions_dependencies core storage)
set(reconciliation_dependencies core storage sessions)
set(ui_dependencies core actions)
set(runtime_dependencies core actions ui)
set(commerce_dependencies core storage)
set(compatibility_headers
    core/core.hpp actions/actions.hpp actions/registry.hpp ui/ui.hpp runtime/runtime.hpp)

file(GLOB_RECURSE files RELATIVE "${IMTG_SOURCE_DIR}/src/imtg"
    "${IMTG_SOURCE_DIR}/src/imtg/*.hpp" "${IMTG_SOURCE_DIR}/src/imtg/*.cpp")
foreach(file IN LISTS files)
    string(REGEX MATCH "^[^/.]+" domain "${file}")
    if(NOT domain IN_LIST domains)
        message(FATAL_ERROR "Unclassified domain: ${file}")
    endif()
    # Source-only optional adapter; its standalone entry is not installed.
    if(file MATCHES "^storage/mdbx_storage[.](hpp|cpp)$")
        continue()
    endif()
    if(file MATCHES "[.]hpp$" AND NOT "imtg/${file}" IN_LIST public_headers)
        message(FATAL_ERROR "Classify the header as public or private explicitly: ${file}")
    endif()
    file(STRINGS "${IMTG_SOURCE_DIR}/src/imtg/${file}" includes REGEX "^#include ")
    if(file MATCHES "[.]cpp$")
        list(GET includes 0 first_include)
        if(NOT first_include STREQUAL "#include <imtg/${domain}.hpp>")
            message(FATAL_ERROR "Implementation must start with its domain umbrella: ${file}")
        endif()
    endif()
    foreach(line IN LISTS includes)
        if(line MATCHES "[.][.]/")
            message(FATAL_ERROR "Parent-relative include: ${file}: ${line}")
        endif()
        if(line MATCHES "^#include [<\"]imtg/([^>\"]+)[>\"]")
            set(entry "${CMAKE_MATCH_1}")
            string(REGEX MATCH "^[^/.]+" dependency "${entry}")
            if(dependency STREQUAL domain)
                if(NOT file IN_LIST compatibility_headers AND NOT file MATCHES "[.]cpp$")
                    message(FATAL_ERROR "Use local intra-domain includes, never the owning umbrella: ${file}: ${line}")
                endif()
            elseif(NOT dependency IN_LIST ${domain}_dependencies)
                message(FATAL_ERROR "Forbidden domain dependency: ${file}: ${line}")
            endif()
            if(NOT line MATCHES "^#include <")
                message(FATAL_ERROR "Cross-domain entry must use angle brackets: ${file}: ${line}")
            endif()
            if(NOT "imtg/${entry}" IN_LIST public_headers)
                message(FATAL_ERROR "Cross-domain entry is not public: ${file}: ${line}")
            endif()
        elseif(line MATCHES "^#include \"([^\"]+)\"")
            get_filename_component(directory "${file}" DIRECTORY)
            set(local "${IMTG_SOURCE_DIR}/src/imtg/${directory}/${CMAKE_MATCH_1}")
            if(NOT EXISTS "${local}")
                message(FATAL_ERROR "Missing local header: ${file}: ${line}")
            endif()
        endif()
    endforeach()
endforeach()
foreach(header IN LISTS public_headers)
    if(NOT EXISTS "${IMTG_SOURCE_DIR}/src/${header}")
        message(FATAL_ERROR "Manifest entry does not exist: ${header}")
    endif()
endforeach()
message(STATUS "Public manifest and hybrid domain include boundaries verified")
