@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/imtgTargets.cmake")

if("telegram_kurlyk" IN_LIST imtg_FIND_COMPONENTS AND @IMTG_BUILD_TELEGRAM_KURLYK@)
    include(CMakeFindDependencyMacro)
    if(NOT TARGET kurlyk::kurlyk)
        find_dependency(kurlyk CONFIG)
    endif()
    if(NOT TARGET imtg_kurlyk_private_dependency)
        add_library(imtg_kurlyk_private_dependency INTERFACE IMPORTED)
        set_property(TARGET imtg_kurlyk_private_dependency PROPERTY
            INTERFACE_LINK_LIBRARIES kurlyk::kurlyk)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/imtgKurlykTargets.cmake")
    set(imtg_telegram_kurlyk_FOUND TRUE)
endif()
check_required_components(imtg)
